# Copy to .env.local for local dev. On Vercel, add the same names under
# Project Settings -> Environment Variables.
# Find both values in Supabase: Project Settings -> API.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Optional: show a "Continue with Google" button (enable the Google provider in Supabase first).
VITE_ENABLE_GOOGLE=false
